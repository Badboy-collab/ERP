datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// NEXORA ERP — MULTI-TENANT SAAS SCHEMA v2.0
// Phase 1 Step 2: org_id REQUIRED + Composite Unique Constraints
// ============================================================

// ============================================================
// ORGANIZATION (Tenant)
// ============================================================
model Organization {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  logo_url         String?
  favicon_url      String?
  industry_type    String   @default("Agro")
  business_type    String   @default("Private")
  country          String   @default("Bangladesh")
  currency         String   @default("BDT")
  timezone         String   @default("Asia/Dhaka")
  language         String   @default("en")
  phone            String?
  email            String?
  website          String?
  address          String?
  financial_year   String   @default("January")
  theme_color      String   @default("#10b981")
  tax_settings     Json?
  vat_settings     Json?
  status           String   @default("Active")
  template         String   @default("Agro Industry")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  // Relations
  subscription     Subscription?
  users            User[]
  depots           Depot[]
  products         Product[]
  dealers          Dealer[]
  lots             LotTracker[]
  deliveryOrders   DeliveryOrder[]
  invoices         Invoice[]
  salesLogs        SalesLog[]
  receiveLogs      ReceiveLog[]
  financialTransactions FinancialTransaction[]
  depotTransactions     DepotTransaction[]
  stockTransfers        StockTransfer[]
  auditLogs        AuditLog[]
  modules          OrganizationModule[]

  @@index([status])
  @@index([slug])
}

// ============================================================
// SUBSCRIPTION & LICENSE
// ============================================================
model Subscription {
  id               String   @id @default(uuid())
  org_id           String   @unique
  organization     Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  plan             String   @default("Trial")
  status           String   @default("Active")
  max_users        Int      @default(5)
  max_branches     Int      @default(2)
  max_warehouses   Int      @default(3)
  max_storage_mb   Int      @default(500)
  max_modules      Int      @default(5)
  api_access       Boolean  @default(false)
  ai_access        Boolean  @default(false)
  backup_limit     Int      @default(7)
  file_storage_mb  Int      @default(100)
  trial_ends_at    DateTime?
  expires_at       DateTime?
  renewal_reminder DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

// ============================================================
// MODULE MANAGEMENT
// ============================================================
model OrganizationModule {
  id          String   @id @default(uuid())
  org_id      String
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  module_key  String
  is_enabled  Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([org_id, module_key])
}

// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  id          String   @id @default(uuid())
  org_id      String?
  organization Organization? @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user_id     String?
  user_name   String?
  action      String
  entity      String
  entity_id   String?
  old_values  Json?
  new_values  Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([org_id])
  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

// ============================================================
// DEPOT (Branch / Warehouse / Section)
// ============================================================
model Depot {
  id        String   @id @default(uuid())
  org_id    String
  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  dealers              Dealer[]
  lots                 LotTracker[]
  deliveryOrders       DeliveryOrder[]
  invoices             Invoice[]
  salesLogs            SalesLog[]
  receiveLogs          ReceiveLog[]
  financialTransactions FinancialTransaction[]
  depotTransactions    DepotTransaction[]
  transfersFrom        StockTransfer[]        @relation("TransfersFrom")
  transfersTo          StockTransfer[]        @relation("TransfersTo")

  @@unique([org_id, code])
  @@index([org_id])
}

// ============================================================
// USER with Granular RBAC Permissions
// ============================================================
model User {
  id            String   @id @default(uuid())
  org_id        String
  organization  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  name          String
  email         String
  password_hash String
  role          String   @default("OPERATOR")
  depot_id      String?
  depot         Depot?   @relation(fields: [depot_id], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Granular Permissions
  can_create_do         Boolean @default(false)
  can_edit_sales        Boolean @default(false)
  can_delete_sales      Boolean @default(false)
  can_create_sales      Boolean @default(true)
  can_receive_stock     Boolean @default(true)
  can_view_reports      Boolean @default(true)
  can_view_accounting   Boolean @default(false)
  can_manage_accounting Boolean @default(false)

  @@unique([org_id, email])
  @@index([org_id])
  @@index([email])
}

// ============================================================
// PRODUCT CATALOG
// ============================================================
model Product {
  id            String       @id @default(uuid())
  org_id        String
  organization  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  code          String
  name          String
  category      String       @default("Poultry Feed")
  bag_size_kg   Float        @default(50.0)
  opening_stock Int          @default(0)
  sort_order    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lots          LotTracker[]
  orderItems    OrderItem[]
  receiveLogs   ReceiveLog[]
  salesLogs     SalesLog[]
  stockTransfers StockTransfer[]

  @@unique([org_id, code])
  @@index([org_id])
}

// ============================================================
// DEALER (belongs to a Depot)
// ============================================================
model Dealer {
  id              String          @id @default(uuid())
  org_id          String
  organization    Organization    @relation(fields: [org_id], references: [id], onDelete: Cascade)
  name            String
  code            String
  phone           String
  address         String?
  depot_id        String
  depot           Depot           @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  current_balance Float           @default(0.0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  deliveryOrders  DeliveryOrder[]
  invoices        Invoice[]
  salesLogs       SalesLog[]
  financialTransactions FinancialTransaction[]

  @@index([org_id])
  @@index([depot_id])
}

// ============================================================
// LOT TRACKER (FIFO Inventory per Depot)
// ============================================================
model LotTracker {
  id                 String       @id @default(uuid())
  org_id             String
  organization       Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  depot_id           String
  depot              Depot        @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  product_id         String
  product            Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  lot_no             String
  mfg_date           DateTime
  exp_date           DateTime
  initial_qty        Int
  sold_qty           Int          @default(0)
  factory_return_qty Int          @default(0)
  transfer_qty       Int          @default(0)
  available_qty      Int
  status             String       @default("Active")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  receiveLogs        ReceiveLog[]
  salesLogs          SalesLog[]
  stockTransfers     StockTransfer[]

  @@index([org_id])
  @@index([depot_id])
  @@index([product_id])
}

// ============================================================
// DELIVERY ORDER (D.O.)
// ============================================================
model DeliveryOrder {
  id            String      @id @default(uuid())
  org_id        String
  organization  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  depot_id      String
  depot         Depot       @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  dealer_id     String
  dealer        Dealer      @relation(fields: [dealer_id], references: [id], onDelete: Cascade)
  order_no      String
  order_date    DateTime    @default(now())
  status        String      @default("Pending")
  remarks       String?
  created_by    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items      OrderItem[]
  invoices   Invoice[]
  salesLogs  SalesLog[]

  @@unique([org_id, order_no])
  @@index([org_id])
  @@index([depot_id])
}

// ============================================================
// ORDER ITEM (D.O. line items)
// ============================================================
model OrderItem {
  id            String        @id @default(uuid())
  order_id      String
  order         DeliveryOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id    String
  product       Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ordered_qty   Int
  delivered_qty Int           @default(0)
  pending_qty   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ============================================================
// INVOICE / CHALLAN
// ============================================================
model Invoice {
  id               String         @id @default(uuid())
  org_id           String
  organization     Organization   @relation(fields: [org_id], references: [id], onDelete: Cascade)
  depot_id         String
  depot            Depot          @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  invoice_no       String
  transaction_type String         @default("SALES")
  date             DateTime       @default(now())
  dealer_id        String?
  dealer           Dealer?        @relation(fields: [dealer_id], references: [id])
  order_id         String?
  order            DeliveryOrder? @relation(fields: [order_id], references: [id])
  destination      String?
  notes            String?
  total_amount     Float          @default(0)
  createdAt        DateTime       @default(now())

  items            SalesLog[]

  @@unique([org_id, invoice_no])
  @@index([org_id])
  @@index([depot_id])
}

// ============================================================
// RECEIVE LOG (Stock In)
// ============================================================
model ReceiveLog {
  id                  String     @id @default(uuid())
  org_id              String
  organization        Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  depot_id            String
  depot               Depot      @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  invoice_no          String
  receive_date        DateTime   @default(now())
  product_id          String
  product             Product    @relation(fields: [product_id], references: [id], onDelete: Cascade)
  lot_id              String
  lot                 LotTracker @relation(fields: [lot_id], references: [id], onDelete: Cascade)
  quantity            Int
  supplier_challan_no String?
  createdAt           DateTime   @default(now())

  @@index([org_id])
  @@index([depot_id])
}

// ============================================================
// SALES LOG (Stock Out line items)
// ============================================================
model SalesLog {
  id               String         @id @default(uuid())
  org_id           String
  organization     Organization   @relation(fields: [org_id], references: [id], onDelete: Cascade)
  invoice_id       String?
  invoice          Invoice?       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  depot_id         String
  depot            Depot          @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  invoice_no       String
  transaction_type String         @default("SALES")
  date             DateTime       @default(now())
  dealer_id        String?
  dealer           Dealer?        @relation(fields: [dealer_id], references: [id])
  order_id         String?
  order            DeliveryOrder? @relation(fields: [order_id], references: [id])
  product_id       String
  product          Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  lot_id           String
  lot              LotTracker     @relation(fields: [lot_id], references: [id], onDelete: Cascade)
  quantity         Int
  unit_price       Float          @default(0)
  total_amount     Float          @default(0)
  createdAt        DateTime       @default(now())

  @@index([org_id])
  @@index([depot_id])
  @@index([date])
}

// ============================================================
// FINANCIAL TRANSACTION (Accounting Module)
// ============================================================
model FinancialTransaction {
  id                String   @id @default(uuid())
  org_id            String
  organization      Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  depot_id          String
  depot             Depot    @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  dealer_id         String?
  dealer            Dealer?  @relation(fields: [dealer_id], references: [id])
  type              String
  amount            Float
  date              DateTime @default(now())
  remarks           String?
  reference_invoice String?
  createdAt         DateTime @default(now())

  @@index([org_id])
  @@index([depot_id])
  @@index([dealer_id])
}

// ============================================================
// DEPOT TRANSACTION / CASH BOOK (Petty Cash Book)
// ============================================================
model DepotTransaction {
  id               String   @id @default(uuid())
  org_id           String
  organization     Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  depot_id         String
  depot            Depot    @relation(fields: [depot_id], references: [id], onDelete: Cascade)
  transaction_type String
  category         String
  amount           Float
  date             DateTime @default(now())
  remarks          String?
  created_by       String?
  createdAt        DateTime @default(now())

  @@index([org_id])
  @@index([depot_id])
}

// ============================================================
// STOCK TRANSFER (Inter-Branch / Factory Transfers)
// ============================================================
model StockTransfer {
  id            String      @id @default(uuid())
  org_id        String
  organization  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  from_depot_id String?
  fromDepot     Depot?      @relation("TransfersFrom", fields: [from_depot_id], references: [id])
  to_depot_id   String?
  toDepot       Depot?      @relation("TransfersTo", fields: [to_depot_id], references: [id])
  product_id    String
  product       Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  lot_id        String?
  lot           LotTracker? @relation(fields: [lot_id], references: [id])
  quantity      Float
  status        String      @default("IN_TRANSIT")
  transfer_date DateTime    @default(now())
  receive_date  DateTime?
  created_by    String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([org_id])
}
